{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/research-run.schema.json",
  "title": "Research Run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "specification",
    "runtime_configuration",
    "model_versions",
    "processed_sources",
    "decisions",
    "expansion_iterations",
    "consumed_budget",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "specification": {"$ref": "#/$defs/versioned_reference"},
    "runtime_configuration": {"$ref": "#/$defs/versioned_reference"},
    "model_versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "processed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "canonical_url", "content_hash"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string", "format": "uri"},
          "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "https://aether-orbis.dev/schemas/qualification-decision.schema.json"
      }
    },
    "expansion_iterations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["iteration", "strategy", "processed_source_ids"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 0},
          "strategy": {"enum": ["enumerate", "expand", "query"]},
          "processed_source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "consumed_budget": {
      "type": "object",
      "required": ["iterations", "cost_rub"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 0},
        "cost_rub": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "outcome": {
      "$ref": "https://aether-orbis.dev/schemas/research-run-outcome.schema.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "versioned_reference": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
        }
      },
      "additionalProperties": false
    }
  }
}
