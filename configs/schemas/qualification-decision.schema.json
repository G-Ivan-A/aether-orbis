{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/qualification-decision.schema.json",
  "title": "Qualification Decision",
  "type": "object",
  "required": [
    "schema_version",
    "decision_id",
    "evaluation_id",
    "policy_id",
    "policy_version",
    "decision",
    "rationale",
    "decided_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "decision_id": {"$ref": "#/$defs/identifier"},
    "evaluation_id": {"$ref": "#/$defs/identifier"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/version"},
    "decision": {"enum": ["QUALIFIED", "CONDITIONAL", "REJECTED"]},
    "matched_rule": {"type": ["integer", "null"], "minimum": 0},
    "rationale": {"type": "string", "minLength": 1},
    "decided_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    }
  }
}
