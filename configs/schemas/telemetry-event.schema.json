{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/telemetry-event.schema.json",
  "title": "Telemetry Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "profile_id",
    "component",
    "operation_role",
    "started_at",
    "finished_at",
    "latency_ms",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "component": {"type": "string", "minLength": 1},
    "operation_role": {
      "enum": ["discovery", "parsing", "extraction", "triage", "full_evaluation", "knowledge_building"]
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "latency_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["ok", "partial", "error"]},
    "error_code": {"type": "string", "minLength": 1},
    "model_call": {
      "type": "object",
      "required": ["provider", "model", "tokens_in", "tokens_out", "cached_tokens", "cost_rub", "batch"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tokens_in": {"type": "integer", "minimum": 0},
        "tokens_out": {"type": "integer", "minimum": 0},
        "cached_tokens": {"type": "integer", "minimum": 0},
        "cost_rub": {"type": "number", "minimum": 0},
        "batch": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "properties": {
        "entity_count": {"type": "integer", "minimum": 0},
        "relation_count": {"type": "integer", "minimum": 0},
        "claim_count": {"type": "integer", "minimum": 0},
        "mean_extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "mean_evidence_strength": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["stage", "characteristics"],
      "properties": {
        "stage": {"enum": ["triage", "full"]},
        "characteristics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^(?!confidence$)[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": ["decision", "policy_id", "policy_version"],
      "properties": {
        "decision": {"enum": ["QUALIFIED", "CONDITIONAL", "REJECTED"]},
        "policy_id": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "matched_rule": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "outcome": {
      "$ref": "https://aether-orbis.dev/schemas/research-run-outcome.schema.json"
    }
  },
  "additionalProperties": false
}
