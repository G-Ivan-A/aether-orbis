{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/research-run-outcome.schema.json",
  "title": "Research Run Outcome",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "coverage",
    "gaps",
    "conflicts",
    "recommended_expansion",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["SUFFICIENT", "PARTIAL", "ZERO", "CONFLICT", "EXHAUSTED"]},
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "gaps": {"$ref": "#/$defs/string_list"},
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "recommended_expansion": {"$ref": "#/$defs/string_list"},
    "rationale": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["status"], "properties": {"status": {"enum": ["PARTIAL", "ZERO", "EXHAUSTED"]}}},
      "then": {"properties": {"gaps": {"minItems": 1}}}
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "CONFLICT"}}},
      "then": {"properties": {"conflicts": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "string_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "conflict": {
      "type": "object",
      "required": ["dimension", "description", "source_group_ids"],
      "properties": {
        "dimension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "description": {"type": "string", "minLength": 1},
        "source_group_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
