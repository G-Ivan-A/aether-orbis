{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/decision-policy.schema.json",
  "title": "Decision Policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_version", "rules", "fallback"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "policy_version": {"$ref": "#/$defs/version"},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "fallback": {"$ref": "#/$defs/decision"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "dimension": {
      "type": "string",
      "pattern": "^(?!confidence$)[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "decision": {
      "enum": ["QUALIFIED", "CONDITIONAL", "REJECTED"]
    },
    "condition": {
      "type": "object",
      "required": ["dimension", "operator", "value"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "operator": {"enum": ["gte", "gt", "lte", "lt", "eq"]},
        "value": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["decision", "all"],
      "properties": {
        "decision": {"$ref": "#/$defs/decision"},
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/condition"}
        }
      },
      "additionalProperties": false
    }
  }
}
