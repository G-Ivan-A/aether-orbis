{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether-orbis.dev/schemas/extraction-result.schema.json",
  "title": "Extraction Result",
  "type": "object",
  "required": [
    "schema_version",
    "extraction_id",
    "source",
    "entities",
    "relations",
    "claims",
    "extraction_meta"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "extraction_id": {"$ref": "#/$defs/identifier"},
    "source": {"$ref": "#/$defs/source_identity"},
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "extraction_meta": {"$ref": "#/$defs/extraction_meta"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$"
    },
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_identity": {
      "type": "object",
      "required": [
        "source_id",
        "canonical_url",
        "content_hash",
        "retrieved_at",
        "published_at",
        "parser_version",
        "extractor_version"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "canonical_url": {"type": "string", "format": "uri"},
        "content_hash": {"$ref": "#/$defs/content_hash"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "published_at": {"type": "string", "format": "date-time"},
        "parser_version": {"type": "string", "minLength": 1},
        "extractor_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "fragment", "retrieved_at", "evidence_strength"],
      "properties": {
        "source_id": {"$ref": "#/$defs/identifier"},
        "fragment": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "evidence_strength": {"$ref": "#/$defs/score"}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name", "extraction_confidence", "evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "extraction_confidence": {"$ref": "#/$defs/score"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "subject",
        "predicate",
        "object",
        "state",
        "extraction_confidence",
        "evidence"
      ],
      "properties": {
        "subject": {"$ref": "#/$defs/identifier"},
        "predicate": {"type": "string", "minLength": 1},
        "object": {"$ref": "#/$defs/identifier"},
        "state": {"enum": ["OBSERVED", "NOT_OBSERVED", "UNCERTAIN", "CONTRADICTED"]},
        "extraction_confidence": {"$ref": "#/$defs/score"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["claim", "entity_ids", "extraction_confidence", "evidence"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "extraction_confidence": {"$ref": "#/$defs/score"},
        "evidence": {"$ref": "#/$defs/evidence"}
      },
      "additionalProperties": false
    },
    "extraction_meta": {
      "type": "object",
      "required": ["status", "model", "operation_role", "extracted_at"],
      "properties": {
        "status": {"enum": ["ok", "partial", "error"]},
        "model": {"type": "string", "minLength": 1},
        "operation_role": {"const": "extraction"},
        "extracted_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
